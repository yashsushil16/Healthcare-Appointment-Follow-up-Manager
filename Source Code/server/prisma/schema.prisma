datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  passwordHash        String
  role                String         // "PATIENT", "DOCTOR", "ADMIN"
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  doctorProfile       DoctorProfile?
  patientAppointments Appointment[]  @relation("PatientAppointments")
  doctorAppointments  Appointment[]  @relation("DoctorAppointments")
  slotHolds           SlotHold[]
}

model DoctorProfile {
  id                  String        @id @default(cuid())
  userId              String        @unique
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialization      String        // e.g., "Cardiology", "Dermatology", "General Medicine", "Pediatrics"
  bio                 String        @default("Experienced healthcare professional dedicated to patient wellness.")
  experienceYears     Int           @default(8)
  consultationFee     Float         @default(60.0)
  slotDurationMinutes Int           @default(30)
  workingHoursStart   String        @default("09:00")
  workingHoursEnd     String        @default("17:00")
  workingDays         String        @default("MON,TUE,WED,THU,FRI")
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  leaves              DoctorLeave[]
}

model DoctorLeave {
  id        String        @id @default(cuid())
  doctorId  String
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate String        // YYYY-MM-DD
  endDate   String        // YYYY-MM-DD
  reason    String?
  createdAt DateTime      @default(now())
}

model SlotHold {
  id        String   @id @default(cuid())
  doctorId  String
  slotTime  DateTime
  patientId String
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([doctorId, slotTime])
}

model Appointment {
  id                           String        @id @default(cuid())
  patientId                    String
  patient                      User          @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)
  doctorId                     String
  doctor                       User          @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  slotTime                     DateTime
  endTime                      DateTime
  status                       String        // "CONFIRMED", "COMPLETED", "CANCELLED", "CANCELLED_DUE_TO_LEAVE"
  symptoms                     String
  preVisitUrgency              String?       // "LOW", "MEDIUM", "HIGH"
  preVisitChiefComplaint       String?
  preVisitSuggestedQuestions   String?       // JSON string array
  postVisitNotes               String?
  postVisitSummary             String?
  postVisitMedicationSchedule  String?       // JSON string array
  postVisitFollowUpSteps       String?       // JSON string array
  googleCalendarEventId        String?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt

  prescription                 Prescription?

  @@unique([doctorId, slotTime])
}

model Prescription {
  id            String      @id @default(cuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  doctorId      String
  medications   String      // JSON string array of { name, dosage, frequency, durationDays }
  createdAt     DateTime    @default(now())
}

model NotificationLog {
  id             String    @id @default(cuid())
  recipientEmail String
  recipientName  String
  type           String    // "BOOKING_CONFIRMATION", "REMINDER", "CANCELLATION", "LEAVE_NOTIFICATION", "MEDICATION_REMINDER"
  subject        String
  content        String
  status         String    // "PENDING", "SENT", "FAILED"
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  errorMsg       String?
  nextRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
